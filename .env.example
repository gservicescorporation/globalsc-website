# --- Base de dados (Postgres) ---
DATABASE_URL=
# "true" se o fornecedor exigir SSL (ex.: Neon, Supabase, Render)
DATABASE_SSL=
NODE_ENV=

# --- Painel admin ---
# Segredo para assinar sessões (mínimo 32 caracteres; gere com: openssl rand -hex 32)
AUTH_SECRET=
# Conta inicial: só é usada para criar o 1º administrador quando a tabela está vazia
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Uploads (UploadThing) ---
UPLOADTHING_TOKEN=

# --- Email (Resend) ---
RESEND_API_KEY=

# --- Pagamentos (AppyPay) ---
GATEWAY_API_URL=
APPYPAY_ACCESS_TOKEN=
APPYPAY_MERCHANT_IDENTIFIER=
APPYPAY_API_KEY=
APPYPAY_GPO_ID=
APPYPAY_REF_ID=
APPY_CLIENT_ID=
APPY_CLIENT_SECRET=
APPY_RESOURCE=
